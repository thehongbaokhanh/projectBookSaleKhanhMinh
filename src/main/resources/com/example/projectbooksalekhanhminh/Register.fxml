<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="550.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectbooksalekhanhminh.Controller.RegisterController">
    <!-- Title -->
    <Label layoutX="268.0" layoutY="25.0" prefHeight="76.0" prefWidth="213.0" text="Register" textAlignment="CENTER">
        <font>
            <Font size="58.0" />
        </font>
    </Label>

    <!-- Username -->
    <Label layoutX="165.0" layoutY="130.0" text="Username:">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <TextField fx:id="usernameField" layoutX="277.0" layoutY="122.0" prefHeight="35.0" prefWidth="230.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <!-- Password -->
    <Label layoutX="165.0" layoutY="180.0" text="Password:">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <PasswordField fx:id="passwordField" layoutX="277.0" layoutY="172.0" prefHeight="35.0" prefWidth="230.0">
        <font>
            <Font size="14.0" />
        </font>
    </PasswordField>

    <!-- Confirm Password -->
    <Label layoutX="135.0" layoutY="230.0" text="Confirm Password:">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <PasswordField fx:id="confirmPasswordField" layoutX="277.0" layoutY="222.0" prefHeight="35.0" prefWidth="230.0">
        <font>
            <Font size="14.0" />
        </font>
    </PasswordField>

    <!-- Phone Number -->
    <Label layoutX="135.0" layoutY="280.0" text="Phone Number:">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <TextField fx:id="phoneField" layoutX="277.0" layoutY="272.0" prefHeight="35.0" prefWidth="230.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <!-- Email -->
    <Label layoutX="195.0" layoutY="330.0" text="Email:">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <TextField fx:id="emailField" layoutX="277.0" layoutY="322.0" prefHeight="35.0" prefWidth="230.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <!-- Address -->
    <Label layoutX="190.0" layoutY="380.0" text="Address:">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <TextField fx:id="addressField" layoutX="277.0" layoutY="372.0" prefHeight="35.0" prefWidth="230.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <!-- Show Password -->
    <CheckBox fx:id="showPasswordCheckBox" layoutX="277.0" layoutY="420.0" text="Show Password" />

    <!-- Register Button -->
    <Button layoutX="337.0" layoutY="460.0" onAction="#handleRegisterButton" prefHeight="40.0" prefWidth="110.0" text="Register">
        <font>
            <Font size="14.0" />
        </font>
    </Button>

    <!-- Already have an account -->
    <Text layoutX="277.0" layoutY="518.0" text="Already have an account? ">
        <font>
            <Font size="14.0" />
        </font>
    </Text>
    <Hyperlink layoutX="438.0" layoutY="499.0" onAction="#handleLoginLink" text="Login">
        <font>
            <Font size="14.0" />
        </font>
    </Hyperlink>
</AnchorPane>
