    <TextField fx:id="usernameField" layoutX="285.0" layoutY="181.0" prefHeight="35.0" prefWidth="230.0" promptText="Username" AnchorPane.leftAnchor="285.0" AnchorPane.rightAnchor="285.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>
    <PasswordField fx:id="passwordField" layoutX="285.0" layoutY="233.0" prefHeight="35.0" prefWidth="230.0" promptText="Password" AnchorPane.leftAnchor="285.0" AnchorPane.rightAnchor="285.0">
        <font>
            <Font size="14.0" />
        </font>
    </PasswordField>

    <TextField fx:id="showPasswordField" layoutX="285.0" layoutY="233.0" managed="false" prefHeight="35.0" prefWidth="230.0" visible="false">
