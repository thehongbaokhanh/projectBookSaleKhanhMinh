<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectbooksalekhanhminh.Controller.RegisterController">
    <!-- Title -->
    <Label layoutX="347.0" layoutY="18.0" prefHeight="84.0" prefWidth="210.0" text="Register" textAlignment="CENTER" AnchorPane.leftAnchor="347.0" AnchorPane.rightAnchor="343.0">
        <font>
            <Font size="58.0" />
        </font>
    </Label>

    <!-- Username -->
    <Label layoutX="227.0" layoutY="130.0" text="Username:" AnchorPane.rightAnchor="609.0">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <TextField fx:id="usernameField" layoutX="277.0" layoutY="122.0" prefHeight="35.0" prefWidth="230.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <!-- Password -->
    <Label layoutX="229.0" layoutY="180.0" text="Password:" AnchorPane.rightAnchor="609.0">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <PasswordField fx:id="passwordField" layoutX="277.0" layoutY="172.0" prefHeight="35.0" prefWidth="230.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0">
        <font>
            <Font size="14.0" />
        </font>
    </PasswordField>

    <TextField fx:id="passwordTextField" layoutX="277.0" layoutY="172.0" prefHeight="35.0" prefWidth="230.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0" visible="false" promptText="Password" />

    <!-- Confirm Password -->
    <Label layoutX="176.0" layoutY="229.0" text="Confirm Password:" AnchorPane.rightAnchor="609.0">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <PasswordField fx:id="confirmPasswordField" layoutX="277.0" layoutY="222.0" prefHeight="35.0" prefWidth="230.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0">
        <font>
            <Font size="14.0" />
        </font>
    </PasswordField>

    <TextField fx:id="confirmPasswordTextField" layoutX="277.0" layoutY="222.0" prefHeight="35.0" prefWidth="230.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0" visible="false" promptText="Confirm Password" />

    <!-- Phone Number -->
    <Label layoutX="212.0" layoutY="280.0" text="Phone Number:" AnchorPane.rightAnchor="609.0">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <TextField fx:id="phoneField" layoutX="277.0" layoutY="272.0" prefHeight="35.0" prefWidth="230.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <!-- Email -->
    <Label layoutX="254.0" layoutY="330.0" text="Email:" AnchorPane.rightAnchor="609.0">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <TextField fx:id="emailField" layoutX="277.0" layoutY="322.0" prefHeight="35.0" prefWidth="230.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <!-- Address -->
    <Label layoutX="234.0" layoutY="380.0" text="Address:" AnchorPane.rightAnchor="609.0">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <TextField fx:id="addressField" layoutX="277.0" layoutY="372.0" prefHeight="35.0" prefWidth="230.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <!-- Show Password -->
    <CheckBox fx:id="showPasswordCheckBox" layoutX="300.0" layoutY="424.0" text="Show Password" onAction="#handleShowPasswordCheckBox" />

    <!-- Register Button -->
    <Button layoutX="395.0" layoutY="468.0" onAction="#handleRegisterButton" prefHeight="40.0" prefWidth="110.0" text="Register" AnchorPane.leftAnchor="395.0" AnchorPane.rightAnchor="395.0">
        <font>
            <Font size="14.0" />
        </font>
    </Button>

    <!-- Already have an account -->
    <Text layoutX="300.0" layoutY="554.0" text="Already have an account? ">
        <font>
            <Font size="14.0" />
        </font>
    </Text>
    <Hyperlink layoutX="461.0" layoutY="534.0" onAction="#handleLoginLink" text="Login">
        <font>
            <Font size="14.0" />
        </font>
    </Hyperlink>
</AnchorPane>
