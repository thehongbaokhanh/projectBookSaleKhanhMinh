    <!-- Phone Number -->
    <Label layoutX="135.0" layoutY="280.0" text="Phone Number:">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <TextField fx:id="phoneField" layoutX="277.0" layoutY="272.0" prefHeight="35.0" prefWidth="230.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

