<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectbooksalekhanhminh.Controller.LoginController">

    <!-- Tiêu đề đăng nhập căn giữa -->
    <Text layoutX="0" layoutY="99.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Login" textAlignment="CENTER" wrappingWidth="900.0">
        <font>
            <Font size="58.0" />
        </font>
    </Text>

    <Label layoutX="225.0" layoutY="229.0" text="Username:" AnchorPane.rightAnchor="610.0">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <!-- Nhãn và TextField cho Username -->
    <Label layoutX="300.0" layoutY="180.0" text="Username:" />
    <TextField fx:id="usernameField" layoutX="300.0" layoutY="200.0" prefHeight="35.0" prefWidth="300.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <Label layoutX="227.0" layoutY="290.0" text="Password:" AnchorPane.rightAnchor="610.0">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <!-- Nhãn và PasswordField cho Password -->
    <Label layoutX="300.0" layoutY="260.0" text="Password:" />
    <PasswordField fx:id="passwordField" layoutX="300.0" layoutY="280.0" prefHeight="35.0" prefWidth="300.0">
        <font>
            <Font size="14.0" />
        </font>
    </PasswordField>
    <TextField fx:id="passwordTextField" layoutX="300.0" layoutY="283.0" prefHeight="35.0" prefWidth="230.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0" visible="false">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <!-- Checkbox để hiển thị mật khẩu -->
    <CheckBox fx:id="showPasswordCheckBox" layoutX="300.0" layoutY="330.0" text="Show Password" />

    <!-- Nút Login căn giữa -->
    <Button layoutX="395.0" layoutY="380.0" onAction="#handleLoginButton" prefHeight="40.0" prefWidth="110.0" text="Login">
        <font>
            <Font size="15.0" />
        </font>
    </Button>

    <!-- Liên kết đăng ký tài khoản -->
    <Text layoutX="365.0" layoutY="450.0" text="Don't have an account? ">
        <font>
            <Font size="14.0" />
        </font>
    </Text>
    <Hyperlink fx:id="registerLink" layoutX="510.0" layoutY="430.0" onAction="#handleRegisterButton" text="Sign Up">
        <font>
            <Font size="14.0" />
        </font>
    </Hyperlink>
</AnchorPane>